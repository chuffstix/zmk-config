#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp N7 &kp N8 &kp N9    &kp KP_DIVIDE   &kp BSPC
                &kp N4 &kp N5 &kp N6    &kp KP_MULTIPLY &kp UP
                &kp N1 &kp N2 &kp N3    &kp KP_MINUS    &kp DOWN
                &kp N0 &kp DOT &kp ENTER &kp KP_PLUS     &mo 1
            >;
        };

        bt_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &none
                &none        &none        &none        &none      &none
                &none        &none        &none        &none      &none
                &none        &none        &none        &none      &trans
            >;
        };
    };
};

