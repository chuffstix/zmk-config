#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp NUM_7  &kp NUM_8  &kp NUM_9  &kp BSPC   &bt BT_CLR
                &kp NUM_4  &kp NUM_5  &kp NUM_6  &kp TAB    &bt BT_NXT
                &kp NUM_1  &kp NUM_2  &kp NUM_3  &kp RET    &mo 1
                &kp NUM_0  &kp DOT    &kp PLUS   &kp MINUS  &kp ASTERISK
            >;
        };

        fn_layer {
            bindings = <
                &bootloader  &none  &none  &none  &none
                &none        &none  &none  &none  &none
                &none        &none  &none  &none  &trans
                &none        &none  &none  &none  &none
            >;
        };
    };
};
